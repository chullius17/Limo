+    <tr><th rowspan="2" >PH   <td rowspan="2" > 2   <td rowspan="2"> 0x55AA  <td rowspan="2">  Header  	       <td> 0xAA <tr> <td> 0x55 
+    <tr><th>CT                <td> 1                <td> 0x01              <td> Type  	                       <td> 0x01
