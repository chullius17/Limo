+                    arguments=['0', '0', '0.02','0', '0', '0', '1','base_link','laser_frame'],
+                    )
+    rviz2_node = Node(package='rviz2',
+                    node_executable='rviz2',
+                    node_name='rviz2',
+                    arguments=['-d', rviz_config_file],
+                    )
+
+    return LaunchDescription([
+        params_declare,
+        driver_node,
+        tf2_node,
+        rviz2_node,
+    ])
