+bool Serial::SerialImpl::waitForChange() {
+#ifndef TIOCMIWAIT
+
+  while (is_open_ == true) {
+
+    int status;
+
+    if (-1 == ioctl(fd_, TIOCMGET, &status)) {
+      return false;
+    } else {
+      if (0 != (status & TIOCM_CTS)
+          || 0 != (status & TIOCM_DSR)
+          || 0 != (status & TIOCM_RI)
+          || 0 != (status & TIOCM_CD)) {
+        return true;
+      }
+    }
+
+    usleep(1000);
+  }
+
+  return false;
+#else
+  int command = (TIOCM_CD | TIOCM_DSR | TIOCM_RI | TIOCM_CTS);
+
+  if (-1 == ioctl(fd_, TIOCMIWAIT, &command)) {
+    return false;
+  }
+
+  return true;
+#endif
+}
