+bool CYdLidar::isRangeIgnore(double angle) const
+{
+  bool ret = false;
+
+  for (uint16_t j = 0; j < m_IgnoreArray.size(); j = j + 2)
+  {
+    if ((math::from_degrees(m_IgnoreArray[j]) <= angle) &&
+        (angle <= math::from_degrees(m_IgnoreArray[j + 1])))
+    {
+      ret = true;
+      break;
+    }
+  }
+
+  return ret;
+}
