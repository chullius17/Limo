+        distros.  I suspect it will be problematic with embeded
+        Linux.   taj
+----------------------------------------------------------*/
+#ifdef LIBLOCKDEV
+int lib_lock_dev_unlock(const char *filename, int pid) {
+  if (dev_unlock(filename, pid)) {
+    //report("fhs_unlock: Unable to remove LockFile\n");
+    return (1);
+  }
+
+  return (0);
+}
