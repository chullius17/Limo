+
+  /*!
+  * @brief 设置雷达异常自动重新连接 \n
+  * @param[in] enable    是否开启自动重连:
+  *     true	开启
+  *	  false 关闭
+  */
+  void setAutoReconnect(const bool &enable);
+
+  /*!
+ * @brief 配置雷达地址 \n
+ * @param[in] timeout  超时时间
+ * @return 返回执行结果
+ * @retval RESULT_OK       配置成功
+ * @retval RESULT_FAILE or RESULT_TIMEOUT   配置超时
+ */
