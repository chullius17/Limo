+/*----------------------------------------------------------
+ lib_lock_dev_unlock
+   accept:      The name of the device to try to unlock
+   perform:     Remove a lock file if there is one using a
+                lock file server.
+   return:      1 on failure 0 on success
+   exceptions:  none
