+            set( PACKAGE_LIB_LINK "-l${PACKAGE_LIB_NAME}" )
+        endif()
+    
+        # build pkg-config file
+        if( PACKAGE_PKG_NAME )
+            configure_file( ${modules_dir}/PkgConfig.pc.in ${PACKAGE_PKG_NAME}.pc @ONLY )
