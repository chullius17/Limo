+  explicit CSimpleSocket(CSimpleSocket &socket);
+
+  virtual ~CSimpleSocket() {
+    if (m_pBuffer != NULL) {
+      delete [] m_pBuffer;
+      m_pBuffer = NULL;
+    }
+  };
