+void TiaLidarDriver::deleteThread()
+{
+    if (m_isScanning) 
+    {
+        m_isScanning = false;
+        ScopedLocker l(_lock);
+        _dataEvent.set();
+    }
+    if (m_thread)
+    {
+      if (m_thread->joinable())
+        m_thread->join();
+      delete m_thread;
+      m_thread = nullptr;
+    }
+    if (m_thread2)
+    {
+      if (m_thread2->joinable())
+        m_thread2->join();
+      delete m_thread2;
+      m_thread2 = nullptr;
+    }
+}
