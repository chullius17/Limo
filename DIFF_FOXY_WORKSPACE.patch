+  
+  /*!
+  * @brief 扫图状态 \n
+  * @return 返回当前雷达扫图状态
+  * @retval true     正在扫图
+  * @retval false    扫图关闭
+  */
+  bool isscanning() const;
+
+  /*!
+  * @brief 连接雷达状态 \n
+  * @return 返回连接状态
+  * @retval true     成功
