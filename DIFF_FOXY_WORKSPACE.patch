+  ret = (configMessage(valName(cfg.motor_en), (char *)configValue[1]) != NULL);
+  ret &= (configMessage(valName(cfg.laser_en), (char *)configValue[1]) != NULL);
+  disConfigConnect();
+  return ret;
+}
