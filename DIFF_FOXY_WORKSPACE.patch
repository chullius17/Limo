+      //打印首点和尾点时间戳
+//      if (scan.points.size())
+//      {
+//        //如果上一圈末点时间戳大于当前圈首点时间戳则打印警告信息，否则打印正常信息
+//        uint64_t lastStamp = scan.stamp +
