+/**
+ * @brief Whether the sampling rate is valid
+ * @param smap  sampling rate map
+ * @return true if it is valid, otherwise false.
+ */
+inline bool isValidSampleRate(std::map<int, int> smap) 
+{
+  if (smap.size() < 1) {
+    return false;
+  }
+
+  if (smap.size() == 1) {
+    if (smap.begin()->second > 2) {
+      return true;
+    }
+
+    return false;
+  }
+
+  return false;
+}
