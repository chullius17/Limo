+#if defined(_WIN32)
+#pragma  comment(lib, "setupapi.lib")
+#ifdef QT_VERSION
+#include <QtGlobal>
+#if (QT_VERSION <= QT_VERSION_CHECK(5,9,0))
+#undef UNICODE
+#endif
+#else
+#undef UNICODE
+#endif
+#include <core/serial/serial.h>
