+  /**
+   * @brief destroy object
+   */
+  virtual ~CYdLidar();
+
+  /**
+   * @brief set lidar properties
+   * @param optname        option name
+   * @param optval         option value
+   * - std::string(or char*)
+   * - int
+   * - bool
