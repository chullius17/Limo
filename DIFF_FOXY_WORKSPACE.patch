+void Serial::SerialImpl::close() {
+  ResetEvent(_wait_o.hEvent);
+
+  if (is_open_ == true) {
+    if (fd_ != INVALID_HANDLE_VALUE) {
+      ::CancelIo(fd_);
+      int ret;
+      ret = CloseHandle(fd_);
+    }
+
+    fd_ = INVALID_HANDLE_VALUE;
+    is_open_ = false;
+  }
+}
