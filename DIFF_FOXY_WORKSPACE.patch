+/*!
+* Enumeration defines the possible parity types for the serial port.
+*/
+typedef enum {
+  parity_none = 0,
+  parity_odd = 1,
+  parity_even = 2,
+  parity_mark = 3,
+  parity_space = 4
+} parity_t;
+
+/*!
+* Enumeration defines the possible stopbit types for the serial port.
+*/
+typedef enum {
+  stopbits_one = 1,
+  stopbits_two = 2,
