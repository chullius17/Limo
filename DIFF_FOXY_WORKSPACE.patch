+inline bool isSerialNumbValid(const LaserDebug &info) {
+  bool ret = false;
+
+  if (isValidValue(info.day) &&
+      isValidValue(info.year) &&
+      isValidValue(info.numH) &&
+      isValidValue(info.numH)) {
+    ret = true;
+  }
+
+  return ret;
+}
