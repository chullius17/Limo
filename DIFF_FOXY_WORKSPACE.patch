+bool Serial::SerialImpl::setTermios(const termios *tio) {
+
+  tcflush(fd_, TCIFLUSH);
+
+  if (fcntl(fd_, F_SETFL, FNDELAY)) {
+    return false;
+  }
+
+  if (::tcsetattr(fd_, TCSANOW, tio) == -1) {
+    return false;
+  }
+
+  return true;
+}
