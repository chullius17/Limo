+    break;
+
+  case LidarPropSingleChannel:
+    memcpy(optval, &m_SingleChannel, optlen);
+    break;
+
+  case LidarPropIntenstiy:
+    memcpy(optval, &m_Intensity, optlen);
+    break;
+  case LidarPropIntenstiyBit:
