+  */
+  virtual bool open();
+
+  /*! Gets the open status of the serial port.
+  *
+  * \return Returns true if the port is open, false otherwise.
+  */
+  virtual bool isOpen();
+
+  /*! Closes the serial port. */
+  virtual void closePort();
+
