+inline bool isVersionValid(const LaserDebug &info) {
+  bool ret = false;
+
+  if (isValidValue(info.cVer) &&
+      isValidValue(info.debug2) &&
+      isValidValue(info.hfVer) &&
+      isValidValue(info.month)) {
+    ret = true;
+  }
