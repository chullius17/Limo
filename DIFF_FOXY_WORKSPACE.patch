+size_t Serial::SerialImpl::available() {
+  if (!is_open_) {
+    return 0;
+  }
+
+  COMSTAT cs;
+  DWORD error;
+
+  if (ClearCommError(fd_, &error, &cs) && error > 0) {
+    PurgeComm(fd_, PURGE_RXABORT | PURGE_RXCLEAR);
+    return 0;
+  }
+
+  return static_cast<size_t>(cs.cbInQue);
+}
