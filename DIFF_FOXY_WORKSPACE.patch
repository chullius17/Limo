+
+  char *result = configMessage(valName(cfg.motor_rpm));
+
+  if (result != NULL) {
+    cfg.motor_rpm = atoi(result);
+    frequency.frequency = static_cast<uint32_t>(100 * (cfg.motor_rpm / 60.f + 0.4));
+    ans = RESULT_OK;
+  }
+
+  return ans;
+
+}
