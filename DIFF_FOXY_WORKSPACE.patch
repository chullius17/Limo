+/*!
+* Class that provides a portable serial port interface.
+*/
+class Serial : public ChannelDevice {
+ public:
+
+  /// Defines all error codes handled by the CSimpleSocket class.
+  typedef enum {
+    NoError,
+    DeviceNotFoundError,
+    PermissionError,
+    OpenError,
+    ParityError,
+    FramingError,
+    BreakConditionError,
+    WriteError,
+    ReadError,
+    ResourceError,
+    UnsupportedOperationError,
+    UnknownError,
+    TimeoutError,
+    NotOpenError
