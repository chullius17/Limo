+//获取数据值（小端序）
+inline uint32_t getLittleValue(const uint8_t *data, int size)
+{
+  uint32_t v = 0;
+  if (!data || !size)
+    return v;
+  for (int i=0; i<size; ++i)
+    v += uint32_t(data[i] << (i * 8));
+  return v;
+}
+
+//获取数据值（大端序）
+inline uint32_t getBigValue(const uint8_t *data, int size)
+{
+  uint32_t v = 0;
+  if (!data || !size)
+    return v;
+  for (int i=0; i<size; ++i)
+    v += uint32_t(data[i] << ((size - 1 - i) * 8));
+  return v;
+}
