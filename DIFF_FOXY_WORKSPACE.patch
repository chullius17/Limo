+DTSLidarDriver::~DTSLidarDriver()
+{
+    m_isScanning = false;
+    isAutoReconnect = false;
+    _thread.join();
+
+    {
+        ScopedLocker l(_cmd_lock);
+        if (_serial)
+        {
+            if (_serial->isOpen())
+            {
+                _serial->flush();
+                _serial->closePort();
+            }
+            delete _serial;
+            _serial = NULL;
+        }
+    }
+
+    {
+        ScopedLocker l(_lock);
+        if (scan_node_buf)
+        {
+            delete[] scan_node_buf;
+            scan_node_buf = NULL;
+        }
+        scan_node_count = 0;
+    }
+}
