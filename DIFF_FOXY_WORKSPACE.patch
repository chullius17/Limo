+   #######################################################
+  # Export library for easy inclusion from other cmake projects. APPEND allows
+  # call to function even as subdirectory of larger project.
+  FILE(REMOVE "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}Targets.cmake")
