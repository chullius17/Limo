+  }
+
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons(50001);
+  addr.sin_addr.s_addr = inet_addr("127.0.0.1");
+
+  if (!connect(s, (struct sockaddr *) &addr, sizeof(addr)) == 0) {
+    free(buffer);
