+
+    /*
+     * @brief 解包激光数据 \n
+     * @param[in] node 解包后激光点信息
+     * @param[in] timeout     超时时间
+     */
+    result_t waitPackage(node_info *node, uint32_t timeout = DEFAULT_TIMEOUT);
+
+    result_t sendCmd(uint8_t cmd,
+                     const uint8_t *data = NULL,
+                     size_t size = 0);
+    //串口发送数据
