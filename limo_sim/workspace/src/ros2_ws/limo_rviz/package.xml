<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>limo_rviz</name>
  <version>0.0.0</version>

  <description>RViz configurations for the LIMO online and offline pipelines.</description>

  <maintainer email="giulio.cataldo@studio.unibo.it">Giulio Cataldo</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- Visualization -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>cv_bridge</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-opencv</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
