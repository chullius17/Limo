<?xml version="1.0"?>
<package format="3">
  <name>limo_cloud_utilities</name>
  <version>0.0.1</version>
  <description>Python processing plugins reproducing the LIMO visual point-cloud pipeline.</description>
  <maintainer email="giulio.cataldo@studio.unibo.it">Giulio Cataldo</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>limo_cloud</depend>
  <depend>rclcpp</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Only the full-pipeline integration launches use the original CV backend. -->
  <exec_depend>cv_package</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-turbojpeg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>cv_bridge</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>tf2_ros</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
