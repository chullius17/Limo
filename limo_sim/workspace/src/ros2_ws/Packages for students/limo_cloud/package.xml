<?xml version="1.0"?>
<package format="3">
  <name>limo_cloud</name>
  <version>0.0.1</version>
  <description>Efficient semantic point-cloud projection with optional C++ and Python processing plugins.</description>
  <maintainer email="giulio.cataldo@studio.unibo.it">Giulio Cataldo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <!-- The optional interpreter adapter links libpython at build and run time. -->
  <depend>python3-dev</depend>
  <exec_depend>python3</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
